# PostgreSQL Ayarları
POSTGRES_USER=cti_admin
POSTGRES_PASSWORD=cti_secret_pass
POSTGRES_DB=cti_radar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ Ayarları
RABBITMQ_DEFAULT_USER=cti_broker
RABBITMQ_DEFAULT_PASS=cti_broker_pass
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_QUEUE=raw_leaks_queue
RABBITMQ_DLQ=raw_leaks_dlq

# Tor & HAProxy Load Balancer
TOR_PROXY_ADDR=haproxy-tor:9050

# Go Collector Ayarları
ENABLE_SIMULATOR=false
SIMULATOR_INTERVAL_SEC=60
WORKER_COUNT=5

# Alarm Webhook (İsteğe bağlı Discord/Slack/Telegram Webhook URL)
ALERT_WEBHOOK_URL=
